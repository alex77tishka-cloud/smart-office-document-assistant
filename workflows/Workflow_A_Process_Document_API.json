      "parameters": {
        "text": "={{ $json.text }}",
        "attributes": {
          "attributes": [
            {
              "name": "customer",
              "description": "Direct customer or company. Return Not found if missing.",
              "required": true
            },
            {
              "name": "end_customer",
              "description": "End customer such as IAI, ELTA or Boeing. Return Not found if missing.",
              "required": true
            },
            {
              "name": "project_or_program",
              "description": "Project or program name. Return Not found if missing.",
              "required": true
            },
            {
              "name": "te_part_numbers",
              "description": "Extract TE part numbers exactly as written.",
              "required": true
            },
            {
              "name": "requested_action",
              "description": "Required action from TE.",
              "required": true
            },
            {
              "name": "strategic_opportunity",
              "description": "Choose exactly one value: Yes or No. Use Yes only when the document indicates a strategic program, significant forecast, competitor replacement, design-in opportunity, or long-term sales potential.",
              "required": true
            },
            {
              "name": "summary",
              "description": "Summarize the document in no more than three short factual sentences. Include the customer request, relevant product or part number, and main business need. Do not invent missing information.",
              "required": true
            },
            {
              "name": "request_type",
              "description": "Choose exactly one value: RFQ, Price Request, Lead Time Request, Technical Request, Alternative Product Request, Sample Request, Quality Complaint, Delivery Complaint, Forecast, Contract Review, Internal Report, or Other.",
              "required": true
            },
            {
              "name": "quantity",
              "description": "Extract the requested quantity exactly as written, including the unit. Return \"Not found\" if no quantity appears.",
              "required": true
            },
            {
              "name": "response_deadline",
              "description": "Extract the deadline for TE to provide a quotation, answer, confirmation, or technical response. Return it exactly as written. Return \"Not found\" if no response deadline appears.",
              "required": true
            },
            {
              "name": "urgency",
              "description": "Choose exactly one value: Low, Medium, or High.  Use High only when there is an immediate deadline, production stop, delivery risk, serious quality issue, legal or compliance risk, or a clear risk of losing strategic business.  Use Medium when action is required but there is no immediate risk. Use Low for general information, forecasts, or requests without a deadline.",
              "required": true
            },
            {
              "name": "competitor_part_numbers",
              "description": "Extract all competitor part numbers exactly as written. Return \"Not found\" if none appear.",
              "required": true
            },
            {
              "name": "product_family",
              "description": "Choose exactly one value: DMC-M, Circular Connectors, Relays, Wires and Cables, Backshells, Fiber Optics, RF / Coax, Heat Shrink, or Other.",
              "required": true
            },
            {
              "name": "target_price",
              "description": "Extract the target price, requested price, or quoted price exactly as written, including currency and unit. Return \"Not found\" if no price appears.",
              "required": true
            },
            {
              "name": "required_delivery",
              "description": "Extract the requested delivery date or delivery period exactly as written. Return \"Not found\" if no required delivery is stated.",
              "required": true
            },
            {
              "name": "competitor",
              "description": "Identify any competitor mentioned in the document, such as Amphenol, Glenair, Leach, or Smiths Interconnect. Return \"Not found\" if no competitor is mentioned.",
              "required": true
            },
            {
              "name": "responsible_team",
              "description": "Choose exactly one value: Sales, Pricing, Product Management, Engineering, Customer Service, Operations, Quality, Legal, Trade Compliance, or General."
            }
          ]
        },
        "options": {}
      },
