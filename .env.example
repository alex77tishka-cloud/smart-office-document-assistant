# Copy to .env and fill in.  Never commit .env.
#
# Anything prefixed VITE_ is bundled into the browser build and is readable by
# anyone using the app. Never put a secret in a VITE_ variable.

# --- Server (Express proxy) — never exposed to the browser ------------------

# Base URL of the n8n instance hosting the webhooks, with no trailing slash.
# Example shape only: https://your-n8n-host.example.com
N8N_BASE_URL=

# Secret key sent to n8n. SERVER-SIDE ONLY.
N8N_API_KEY=

# Header the key is sent in. Confirmed value for this project: x-api-key
N8N_API_KEY_HEADER=x-api-key

# Port the Express server listens on. The Vite dev proxy forwards /api here.
PORT=3001

# How long to wait for a plain read (GET /webhook/documents), in milliseconds.
N8N_TIMEOUT_MS=30000

# How long to wait for document processing, in milliseconds. Processing runs AI
# extraction, a Drive upload, a Sheets write and a notification, so it needs far
# longer than a read.
N8N_PROCESS_TIMEOUT_MS=180000

# Maximum request body the proxy accepts. Base64 inflates a file by about a
# third, so keep this comfortably above the largest file the UI allows (10 MB).
MAX_REQUEST_BODY=20mb

# --- Client (safe, non-secret) ---------------------------------------------

# true  = use local mock data, no network at all
# false = call the Express proxy, which calls n8n
VITE_USE_MOCKS=true

# Base path for the Express API. Defaults to /api; rarely needs changing.
# VITE_API_BASE_URL=/api
